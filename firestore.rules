rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts that pitch/onboard businesses on Gears' behalf — kept in sync
    // with ADMIN_EMAILS in webapp/src/main.jsx. Only these can mark a listing
    // verified (tier 1); everyone else's onboarding lands on claimed (tier 2).
    function isAdminEmail() {
      return request.auth.token.email in
        ['aciestech21@gmail.com', 'skyemmanuel42@gmail.com', 'princeessandoh316@gmail.com'];
    }

    // Who may read a given mechanic doc: anonymous browsers (search is free),
    // super admins (the whole directory), or the business that owns it. A
    // signed-in business must NOT see the rest of the directory — only its
    // own listing(s), matched on createdBy (and onboardedBy for admins).
    function canReadMechanic(doc) {
      return request.auth == null
        || isAdminEmail()
        || ('createdBy' in doc && doc.createdBy == request.auth.uid)
        || ('onboardedBy' in doc && doc.onboardedBy == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // Mechanics collection
    // ---------------------------------------------------------------
    match /mechanics/{mechanicId} {
      // Anonymous browsers, super admins, and the owning business can read.
      allow read: if canReadMechanic(resource.data);

      // Only authenticated users can submit a new mechanic
      // Validates required fields are non-empty strings
      // A business needs a phone OR an email — some (e.g. an email-only
      // supplier) don't want calls/a phone number published at all.
      // "verified: true" can only be set by an admin account — everyone else
      // starts at most "claimed" and needs Gears staff to flip it manually.
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && ((request.resource.data.phone is string && request.resource.data.phone.size() > 0)
            || (request.resource.data.email is string && request.resource.data.email.size() > 0))
        && (!('verified' in request.resource.data) || request.resource.data.verified != true || isAdminEmail())
        && (!('lat' in request.resource.data) || request.resource.data.lat == null || request.resource.data.lat is number)
        && (!('lng' in request.resource.data) || request.resource.data.lng == null || request.resource.data.lng is number)
        && (!('specialties' in request.resource.data) || request.resource.data.specialties == null || request.resource.data.specialties is list);

      // Creator can update any field except "verified" (only an admin can
      // flip that). Anyone can update ratings or analytics counter fields.
      allow update: if (
        (request.auth != null && resource.data.createdBy == request.auth.uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
              || isAdminEmail())) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount', 'ratingSum', 'visitCount', 'callCount', 'bookmarkCount', 'searchCount']))
      );

      // Submitter can delete their own listing
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // ---------------------------------------------------------------
      // Ratings sub-collection: one document per user per mechanic
      // ---------------------------------------------------------------
      match /ratings/{userId} {
        allow read: if canReadMechanic(get(/databases/$(database)/documents/mechanics/$(mechanicId)).data);

        // A user can only write their own rating document
        allow write: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
      }

      // ---------------------------------------------------------------
      // Products, Services, Media sub-collections
      // ---------------------------------------------------------------
      match /products/{productId} {
        allow read: if canReadMechanic(get(/databases/$(database)/documents/mechanics/$(mechanicId)).data);
        allow write: if request.auth != null;
        // Per-item click/chat counters — same no-auth-required,
        // field-restricted pattern as the mechanic-level analytics
        // counters, so anonymous browsing/ordering can still count.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'chatCount']);
      }
      match /services/{serviceId} {
        allow read: if canReadMechanic(get(/databases/$(database)/documents/mechanics/$(mechanicId)).data);
        allow write: if request.auth != null;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'chatCount']);
      }
      match /media/{mediaId} {
        allow read: if canReadMechanic(get(/databases/$(database)/documents/mechanics/$(mechanicId)).data);
        allow write: if request.auth != null;
      }
      // Detailer package bundles — same shape as products/services, just
      // never had this rule written, so reads/writes here were silently
      // denied (a detailer's own dashboard could never publish a package
      // to their public listing).
      match /packages/{packageId} {
        allow read: if canReadMechanic(get(/databases/$(database)/documents/mechanics/$(mechanicId)).data);
        allow write: if request.auth != null;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'chatCount']);
      }
    }

    // ---------------------------------------------------------------
    // App config — e.g. the business-admin emails list. Public read (it's
    // only a client-side routing hint), write restricted to super admins.
    // Manage it at: Firestore → config → businessAdmins → `emails` (array).
    // ---------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    // ---------------------------------------------------------------
    // Users collection — bookmarks and coarse location live on the root
    // doc; notifications are Cloud-Function-written only.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['savedMechanics', 'location']);

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedMechanics', 'location']);

      // A user can read and mark their own notifications read, but never
      // create or delete one directly — only a Cloud Function (Admin SDK,
      // which bypasses these rules entirely) writes new notification docs.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

  }
}
